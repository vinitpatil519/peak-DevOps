          "refId": "A",
          "expr": "clamp_max(1 - (sum(increase(http_requests_total{namespace=\"backend\",status=~\"5..\"}[30d])) / clamp_min(sum(increase(http_requests_total{namespace=\"backend\"}[30d])), 1)), 1)",
